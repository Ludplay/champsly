NODE_ENV=development
PORT=4001

DB_USERNAME=user
DB_PASSWORD=pass
DB_DATABASE=champsly
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

# Read-side connection. Each falls back to its DB_* counterpart when unset.
# DB_READ_USERNAME/DB_READ_PASSWORD let a real replica use a separate,
# least-privilege (read-only) DB role instead of the write credentials.
DB_READ_HOST=
DB_READ_PORT=
DB_READ_USERNAME=
DB_READ_PASSWORD=

CORS_ORIGIN=http://127.0.0.1:5173

PASSWORD_HASH_COST=12
JWT_ACCESS_SECRET=changeme-generate-a-random-64-byte-hex-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400

PUBLIC_URL=http://127.0.0.1:5173

KAFKA_BROKERS=champsly-kafka-1:9092,champsly-kafka-2:9092,champsly-kafka-3:9092
KAFKA_CLIENT_ID=champsly-backend
